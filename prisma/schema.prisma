generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

enum UserRole {
  creator

  brand

  admin

  staff
}

enum KycStatus {
  not_started

  pending

  verified

  rejected
}

enum CampaignStatus {
  draft

  /// Submitted by a brand/staff member; goes live only when an admin approves.
  pending_review

  live

  paused

  closed
}

enum NewClipperIntakeStatus {
  open

  closed_at_threshold

  manually_extended
}

enum CampaignWizardStep {
  basics

  brief

  payout

  review
}

enum CampaignOwnership {
  brand_created

  admin_created
}

enum CampaignInviteStatus {
  pending

  accepted

  expired

  revoked
}

enum SubmissionStatus {
  draft_submitted

  under_review

  approved

  awaiting_live_link

  live_tracking

  payout_pending

  paid

  rejected
}

enum FormatDeliverableStatus {
  draft_pending

  under_review

  draft_rejected

  draft_approved

  live_submitted

  proof_under_review

  proof_approved

  proof_rejected
}

enum AutoReviewDecision {
  auto_approved

  auto_rejected

  needs_review
}

enum AutoReviewStage {
  draft

  proof
}

enum SourceAssetRequirement {
  mandatory

  optional

  not_required
}

enum TransactionType {
  earning_credit

  withdrawal_debit

  fee_debit

  adjustment
}

enum WithdrawalStatus {
  pending

  processing

  completed

  failed
}

enum StaffAccessLevel {
  view_only

  full
}

enum TaskStatus {
  todo

  in_progress

  done
}

enum SupportTicketStatus {
  under_investigation

  resolved
}

enum AdminSection {
  dashboard

  brands

  clippers

  campaigns

  analytics

  tickets

  faqs

  notifications

  team
}

enum AdminPermissionLevel {
  hidden

  view

  manage
}

model User {
  id String @id @default(cuid())

  role UserRole

  email String? @unique

  phone String? @unique

  passwordHash String? @map("password_hash")

  displayName String? @map("display_name")

  avatarUrl String? @map("avatar_url")

  bio String? @db.Text

  socialLinks Json? @map("social_links")

  socialStats Json? @map("social_stats")

  username String? @unique

  fixedOtpCode String? @map("fixed_otp_code") @db.VarChar(6)

  kycStatus KycStatus @default(not_started) @map("kyc_status")

  isActive Boolean @default(true) @map("is_active")

  termsAcceptedAt DateTime? @map("terms_accepted_at")

  kycDocumentUrl String? @map("kyc_document_url")

  kycDocumentType String? @map("kyc_document_type")

  kycSubmittedAt DateTime? @map("kyc_submitted_at")

  kycReviewedAt DateTime? @map("kyc_reviewed_at")

  kycRejectionReason String? @map("kyc_rejection_reason")

  // Signup verification gate (PAN + Aadhaar auto-verified via Cashfree,
  // Instagram manually reviewed by an admin) — a newer, separate flow
  // from the generic kyc* fields above. Only enforced for accounts where
  // requiresOnboardingGate is true; existing users at the time this
  // shipped are grandfathered in with it false, so they're never
  // retroactively locked out.
  requiresOnboardingGate Boolean @default(false) @map("requires_onboarding_gate")

  panNumber String? @map("pan_number")

  panDocumentUrl String? @map("pan_document_url")

  panVerificationStatus KycStatus @default(not_started) @map("pan_verification_status")

  panVerifiedName String? @map("pan_verified_name")

  panVerifiedAt DateTime? @map("pan_verified_at")

  panFailureReason String? @map("pan_failure_reason")

  // The uploaded Aadhaar image is kept only long enough to run the OCR
  // verification call — see CashfreeVerificationService — never the raw
  // Aadhaar number itself, only a masked last-4 reference.
  aadhaarDocumentUrl String? @map("aadhaar_document_url")

  aadhaarVerificationStatus KycStatus @default(not_started) @map("aadhaar_verification_status")

  aadhaarVerifiedName String? @map("aadhaar_verified_name")

  aadhaarMaskedNumber String? @map("aadhaar_masked_number")

  aadhaarVerifiedAt DateTime? @map("aadhaar_verified_at")

  aadhaarFailureReason String? @map("aadhaar_failure_reason")

  // Instagram itself is real (OAuth-connected, see InstagramConnection) —
  // this tracks the separate admin judgment call of whether that account
  // looks like a genuine clipper, not an outsider.
  instagramReviewStatus KycStatus @default(not_started) @map("instagram_review_status")

  instagramReviewedAt DateTime? @map("instagram_reviewed_at")

  instagramReviewedByUserId String? @map("instagram_reviewed_by_user_id")

  instagramRejectionReason String? @map("instagram_rejection_reason")

  // A permanent, randomly-generated 9-digit public identifier — assigned
  // once, the first time this creator's Instagram gets verified, and shown
  // in place of their real name on leaderboards from then on (real names +
  // real earnings, publicly visible to every other creator, was the
  // problem this solves). One per person (User), not per CreatorProfile —
  // every profile they connect afterward shares this same number. Never
  // reassigned or regenerated once set. Null until verified.
  verifiedCreatorId String? @unique @map("verified_creator_id")

  // Null = Super Admin (full, unrestricted access) — the default for every
  // existing admin so assigning this feature never silently locks anyone
  // out. Only set for admins deliberately restricted to a custom role.
  adminRoleId String? @map("admin_role_id")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  brandProfile BrandProfile?

  wallet Wallet?

  submissions Submission[]

  campaignParticipations CampaignParticipation[]

  creatorProfiles CreatorProfile[]

  deliverablesReviewed FormatDeliverable[] @relation("DeliverableReviewedBy")

  deliverableRejections DeliverableRejectionEvent[] @relation("RejectionReviewedBy")

  payoutMethods PayoutMethod[]

  withdrawals Withdrawal[]

  staffBrandAssignments StaffBrandAssignment[] @relation("StaffAssignments")

  refreshTokens RefreshToken[]

  passwordResetTokens PasswordResetToken[]

  campaignsCreated Campaign[] @relation("CampaignCreatedBy")

  campaignInvitesSent CampaignInvite[] @relation("CampaignInviteInviter")

  campaignInvitesAccepted CampaignInvite[] @relation("CampaignInviteAcceptor")

  tasksAssigned Task[] @relation("TaskAssignee")

  tasksCreated Task[] @relation("TaskCreatedBy")

  activityLogs ActivityLog[] @relation("ActivityActor")

  notifications Notification[] @relation("NotificationRecipient")

  deviceTokens DeviceToken[]

  instagramOAuthTransactions InstagramOAuthTransaction[]

  instagramConnections InstagramConnection[]

  youtubeConnections YoutubeConnection[]

  supportTickets SupportTicket[]

  bulkNotificationsSent BulkNotificationLog[]

  adminRole AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  @@map("users")
}

model OtpSession {
  id String @id @default(cuid())

  phone String

  codeHash String @map("code_hash")

  expiresAt DateTime @map("expires_at")

  attempts Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("otp_sessions")
}

model RefreshToken {
  id String @id @default(cuid())

  userId String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime @map("expires_at")

  usedAt DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model BrandProfile {
  id String @id @default(cuid())

  userId String @unique @map("user_id")

  companyName String @map("company_name")

  companyEmail String? @map("company_email")

  logoUrl String? @map("logo_url")

  pocName String? @map("poc_name")

  pocPhone String? @map("poc_phone")

  pocEmail String? @map("poc_email")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  staffAssignments StaffBrandAssignment[]

  tasks Task[]

  activityLogs ActivityLog[]

  @@map("brand_profiles")
}

model StaffBrandAssignment {
  id String @id @default(cuid())

  staffUserId String @map("staff_user_id")

  brandProfileId String @map("brand_profile_id")

  accessLevel StaffAccessLevel @default(full) @map("access_level")

  assignedAt DateTime @default(now()) @map("assigned_at")

  staffUser User @relation("StaffAssignments", fields: [staffUserId], references: [id], onDelete: Cascade)

  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, brandProfileId])
  @@index([staffUserId])
  @@index([brandProfileId])
  @@map("staff_brand_assignments")
}

model Task {
  id String @id @default(cuid())

  title String

  description String? @db.Text

  assignedToUserId String @map("assigned_to_user_id")

  createdByUserId String @map("created_by_user_id")

  brandProfileId String? @map("brand_profile_id")

  dueDate DateTime? @map("due_date")

  status TaskStatus @default(todo)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)

  createdBy User @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  @@index([assignedToUserId])
  @@index([status])
  @@map("tasks")
}

model ActivityLog {
  id String @id @default(cuid())

  actorUserId String @map("actor_user_id")

  action String

  targetType String @map("target_type")

  targetId String @map("target_id")

  brandProfileId String? @map("brand_profile_id")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([brandProfileId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("activity_logs")
}

model Notification {
  id String @id @default(cuid())

  recipientUserId String @map("recipient_user_id")

  type String

  title String

  body String? @db.Text

  link String?

  read Boolean @default(false)

  readAt DateTime? @map("read_at")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  recipient User @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, read])
  @@index([createdAt])
  @@map("notifications")
}

model DeviceToken {
  id String @id @default(cuid())

  userId String @map("user_id")

  token String @unique

  platform String

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Campaign {
  id String @id @default(cuid())

  brandProfileId String? @map("brand_profile_id")

  createdByUserId String? @map("created_by_user_id")

  ownership CampaignOwnership @default(brand_created)

  wizardStep CampaignWizardStep @default(basics) @map("wizard_step")

  inviteAcceptedAt DateTime? @map("invite_accepted_at")

  /// Admin approval trail for brand/staff campaigns (see pending_review).
  submittedForReviewAt DateTime? @map("submitted_for_review_at")

  /// Why an admin sent it back; shown to the brand until it's resubmitted.
  reviewRejectionReason String? @map("review_rejection_reason") @db.Text

  reviewedAt DateTime? @map("reviewed_at")

  reviewedByUserId String? @map("reviewed_by_user_id")

  title String

  category String?

  platform String @default("instagram_reel")

  platforms String[] @default([])

  locationType String @default("pan_india") @map("location_type")

  targetStates String[] @default([]) @map("target_states")

  status CampaignStatus @default(draft)

  brief String @db.Text

  briefHook String? @map("brief_hook") @db.Text

  doRules String? @map("do_rules") @db.Text

  avoidRules String? @map("avoid_rules") @db.Text

  sourceAssets Json? @map("source_assets")

  sourceVideoRequirement SourceAssetRequirement @default(mandatory) @map("source_video_requirement")

  sourceAudioRequirement SourceAssetRequirement @default(not_required) @map("source_audio_requirement")

  referenceAssets Json? @map("reference_assets")

  coverImageUrl String? @map("cover_image_url")

  productUrl String? @map("product_url")

  ratePer1kPaise Int @map("rate_per_1k_paise")

  maxPayoutPaise Int @map("max_payout_paise")

  budgetPaise Int @map("budget_paise")

  budgetUsedPaise Int @default(0) @map("budget_used_paise")

  newClipperIntakeStatus NewClipperIntakeStatus @default(open) @map("new_clipper_intake_status")

  extraClipperAllowance Int? @map("extra_clipper_allowance")

  allowExcessViewsToFillPool Boolean @default(false) @map("allow_excess_views_to_fill_pool")

  poolThresholdBps Int @default(8000) @map("pool_threshold_bps")

  maxRepostsPerClip Int? @default(5) @map("max_reposts_per_clip")

  complianceChecklist Json? @map("compliance_checklist")

  autoReviewEnabled Boolean @default(false) @map("auto_review_enabled")

  startDate DateTime? @map("start_date")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  createdBy User? @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  submissions Submission[]

  participations CampaignParticipation[]

  invites CampaignInvite[]

  @@index([status])
  @@index([brandProfileId])
  @@index([ownership])
  @@map("campaigns")
}

model CampaignInvite {
  id String @id @default(cuid())

  campaignId String @map("campaign_id")

  email String

  tokenHash String @unique @map("token_hash")

  status CampaignInviteStatus @default(pending)

  expiresAt DateTime @map("expires_at")

  acceptedAt DateTime? @map("accepted_at")

  invitedByUserId String @map("invited_by_user_id")

  acceptedByUserId String? @map("accepted_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  invitedBy User @relation("CampaignInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  acceptedBy User? @relation("CampaignInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([email])
  @@map("campaign_invites")
}

model Submission {
  id String @id @default(cuid())

  campaignId String @map("campaign_id")

  creatorId String @map("creator_id")

  status SubmissionStatus @default(draft_submitted)

  mediaType String @default("video") @map("media_type")

  draftDriveUrl String? @map("draft_drive_url")

  draftStorageKey String? @map("draft_storage_key")

  liveReelUrl String? @map("live_reel_url")

  eligibleViews Int @default(0) @map("eligible_views")

  estimatedPaise Int @default(0) @map("estimated_paise")

  rejectionReason String? @map("rejection_reason")

  submittedAt DateTime @default(now()) @map("submitted_at")

  approvedAt DateTime? @map("approved_at")

  liveLinkAt DateTime? @map("live_link_at")

  paidAt DateTime? @map("paid_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@index([campaignId, status])
  @@map("submissions")
}

model CampaignParticipation {
  id String @id @default(cuid())

  campaignId String @map("campaign_id")

  creatorId String @map("creator_id")

  creatorProfileId String @map("creator_profile_id")

  platformsSnapshot String[] @map("platforms_snapshot")

  joinedAt DateTime @default(now()) @map("joined_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  deliverables FormatDeliverable[]

  @@unique([campaignId, creatorProfileId])
  @@index([creatorId])
  @@index([creatorProfileId])
  @@map("campaign_participations")
}

model CreatorProfile {
  id String @id @default(cuid())

  userId String @map("user_id")

  platform String

  handle String

  label String?

  avatarUrl String? @map("avatar_url")

  isDefault Boolean @default(false) @map("is_default")

  socialLinks Json? @default("{}") @map("social_links")

  socialStats Json? @default("{}") @map("social_stats")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  participations CampaignParticipation[]

  instagramOAuthTransactions InstagramOAuthTransaction[]

  instagramConnections InstagramConnection[]

  youtubeConnections YoutubeConnection[]

  insightSnapshots SocialAccountInsightSnapshot[]

  @@unique([userId, platform, handle])
  @@index([userId])
  @@map("creator_profiles")
}

model InstagramOAuthTransaction {
  id String @id @default(cuid())

  transactionId String @unique @map("transaction_id")

  stateHash String @unique @map("state_hash")

  userId String @map("user_id")

  creatorProfileId String @map("creator_profile_id")

  status String @default("started")

  encryptedAccessToken String? @map("encrypted_access_token") @db.Text

  tokenExpiresAt DateTime? @map("token_expires_at")

  dataAccessExpiresAt DateTime? @map("data_access_expires_at")

  errorCode String? @map("error_code")

  expiresAt DateTime @map("expires_at")

  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([creatorProfileId])
  @@index([expiresAt])
  @@map("instagram_oauth_transactions")
}

model InstagramConnection {
  id String @id @default(cuid())

  userId String @map("user_id")

  creatorProfileId String @unique @map("creator_profile_id")

  platformUserId String @map("platform_user_id")

  platformHandle String @map("platform_handle")

  encryptedAccessToken String @map("encrypted_access_token") @db.Text

  tokenExpiresAt DateTime? @map("token_expires_at")

  dataAccessExpiresAt DateTime? @map("data_access_expires_at")

  followerCount Int @default(0) @map("follower_count")

  followsCount Int @default(0) @map("follows_count")

  mediaCount Int @default(0) @map("media_count")

  engagementRate Float @default(0) @map("engagement_rate")

  profilePictureUrl String? @map("profile_picture_url")

  metadata Json @default("{}")

  isConnected Boolean @default(true) @map("is_connected")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformUserId])
  @@map("instagram_connections")
}

model YoutubeConnection {
  id String @id @default(cuid())

  userId String @map("user_id")

  creatorProfileId String @unique @map("creator_profile_id")

  platformUserId String @map("platform_user_id")

  platformHandle String @map("platform_handle")

  encryptedAccessToken String @map("encrypted_access_token") @db.Text

  encryptedRefreshToken String? @map("encrypted_refresh_token") @db.Text

  tokenExpiresAt DateTime? @map("token_expires_at")

  subscriberCount Int @default(0) @map("subscriber_count")

  videoCount Int @default(0) @map("video_count")

  totalViewCount Int @default(0) @map("total_view_count")

  engagementRate Float @default(0) @map("engagement_rate")

  profilePictureUrl String? @map("profile_picture_url")

  metadata Json @default("{}")

  isConnected Boolean @default(true) @map("is_connected")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformUserId])
  @@map("youtube_connections")
}

model FormatDeliverable {
  id String @id @default(cuid())

  participationId String @map("participation_id")

  platform String

  draftDriveUrl String? @map("draft_drive_url")

  /**
   * A copy of the source video the brand/admin uploaded themselves — for
   * when draftDriveUrl is a Google Drive link the auto-review pipeline can't
   * fetch (Drive links need OAuth/service-account access and don't reliably
   * return raw bytes for a plain HTTP fetch). When set, the auto-review
   * pipeline reads this instead of draftDriveUrl; draftDriveUrl itself is
   * untouched — it stays the creator's actual submission record.
   */
  adminUploadedDraftUrl String? @map("admin_uploaded_draft_url")

  livePostUrl String? @map("live_post_url")

  status FormatDeliverableStatus @default(draft_pending)

  rejectionReason String? @map("rejection_reason")

  draftSubmittedAt DateTime? @map("draft_submitted_at")

  draftReviewedAt DateTime? @map("draft_reviewed_at")

  liveSubmittedAt DateTime? @map("live_submitted_at")

  /** The creator's Instagram follower count at the moment this deliverable's
   * live-proof link was submitted — fetched fresh from the Graph API right
   * then (see ParticipationService.submitLiveProof), not copied from
   * InstagramConnection.followerCount, which only ever holds the latest
   * synced value. Null for non-Instagram platforms, or when the live fetch
   * failed (never blocks the submission itself). Used by the campaign
   * report's per-reel ledger export. */
  followerCountAtPost Int? @map("follower_count_at_post")

  viewCount Int @default(0) @map("view_count")

  reach Int @default(0)

  likeCount Int @default(0) @map("like_count")

  commentCount Int @default(0) @map("comment_count")

  shareCount Int @default(0) @map("share_count")

  proofReviewedAt DateTime? @map("proof_reviewed_at")

  reviewedByUserId String? @map("reviewed_by_user_id")

  paidAt DateTime? @map("paid_at")

  paidAmountPaise Int? @map("paid_amount_paise")

  listedInMarketplace Boolean @default(false) @map("listed_in_marketplace")

  delistedAt DateTime? @map("delisted_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  participation CampaignParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  reviewedBy User? @relation("DeliverableReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  rejectionEvents DeliverableRejectionEvent[]

  insightSnapshots DeliverableInsightSnapshot[]

  marketplaceListingReposts MarketplaceRepost[] @relation("MarketplaceSource")

  marketplaceRepostClaim MarketplaceRepost? @relation("MarketplacePoster")

  autoReviewResults AutoReviewResult[]

  @@unique([participationId, platform])
  @@index([participationId])
  @@index([status])
  @@index([listedInMarketplace, delistedAt])
  @@map("format_deliverables")
}

model MarketplaceRepost {
  id String @id @default(cuid())

  sourceDeliverableId String @map("source_deliverable_id")

  posterDeliverableId String @unique @map("poster_deliverable_id")

  posterCreatorId String @map("poster_creator_id")

  originalCreatorSharePaise Int? @map("original_creator_share_paise")

  posterSharePaise Int? @map("poster_share_paise")

  createdAt DateTime @default(now()) @map("created_at")

  sourceDeliverable FormatDeliverable @relation("MarketplaceSource", fields: [sourceDeliverableId], references: [id], onDelete: Cascade)

  posterDeliverable FormatDeliverable @relation("MarketplacePoster", fields: [posterDeliverableId], references: [id], onDelete: Cascade)

  @@index([sourceDeliverableId])
  @@index([posterCreatorId, createdAt])
  @@map("marketplace_reposts")
}

/**
 * Shadow-mode audit log for the automated proof-review pipeline — never
 * read by anything that gates payout or the deliverable's real status.
 * Purely so an automated decision can later be compared against what a
 * human actually decided, before anyone trusts it to skip review for real.
 */
model AutoReviewResult {
  id String @id @default(cuid())

  deliverableId String @map("deliverable_id")

  stage AutoReviewStage @default(proof)

  decision AutoReviewDecision

  tier1Results Json @map("tier1_results")

  tier2Results Json? @map("tier2_results")

  modelVersion String? @map("model_version")

  createdAt DateTime @default(now()) @map("created_at")

  deliverable FormatDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, createdAt])
  @@map("auto_review_results")
}

