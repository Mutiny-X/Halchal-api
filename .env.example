# Copy to .env — never commit .env

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

JWT_SECRET=change-me-to-at-least-32-chars-long-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL=1h

# Portal — production (Railway / halchalapp.com)
CORS_ORIGINS=https://app.halchalapp.com
WEB_URL=https://app.halchalapp.com
# Local dev (uncomment and use instead when running portal on localhost:3000)
# CORS_ORIGINS=http://localhost:3000
# WEB_URL=http://localhost:3000

BRAND_INVITE_TTL=7d
WITHDRAWAL_FEE_BPS=150

OTP_DEV_LOG=true
# Dev only: any phone accepts this OTP (no WhatsApp). Run `pnpm prisma:seed` for demo logins.
OTP_DEV_BYPASS_CODE=000000

# Lets the App Store / Play Store reviewer phone numbers and per-account fixed
# OTP codes work in PRODUCTION. Leave unset (off); set to true only for the
# days a store review is running, then remove it. Always on outside production.
# REVIEWER_OTP_ENABLED=true

# Serves the interactive API reference at /docs in production. Off by default
# there (it maps every endpoint); always on outside production.
# ENABLE_API_DOCS=true
WHATSAPP_PHONE_NUMBER_ID=1042883462242562
WHATSAPP_BUSINESS_ACCOUNT_ID=1834764957377959
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE_NAME=halchal_otp_login
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true

# Preferred on Railway (HTTPS). Same re_... key as Resend SMTP password.
RESEND_API_KEY=
EMAIL_FROM=

# Optional local fallback when RESEND_API_KEY is unset (blocked on Railway Hobby).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Apify — used to scrape Instagram/YouTube/Twitter follower & post counts
# Get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# apps/portal/.env → VITE_API_URL=http://localhost:3001

# Mobile app update banner. Leave unset to hide the banner.
# Set these to the version number you just published, after each store release.
APP_LATEST_IOS_VERSION=
APP_LATEST_ANDROID_VERSION=
APP_STORE_URL=
PLAY_STORE_URL=

# Instagram Login OAuth - creator Instagram connection.
# Configure this exact URL in Meta > Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.halchalapp.com/creator/profiles/social/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic
INSTAGRAM_OAUTH_DEBUG_LOG_SECRETS=false
# Optional; defaults to a key derived from JWT_SECRET when unset.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# YouTube OAuth - creator YouTube connection.
# Configure this exact URL in Google Cloud OAuth redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.halchalapp.com/creator/profiles/social/youtube/callback
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly
# Optional; defaults to a key derived from JWT_SECRET when unset.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Push notifications (FCM). Firebase Console (halchal-5108a) > Project
# Settings > Service Accounts > Generate new private key, then:
#   base64 -i service-account.json | tr -d '\n'
# Unset = push notifications only log what would be sent.
FIREBASE_SERVICE_ACCOUNT_BASE64=
